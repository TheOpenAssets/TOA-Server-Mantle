# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

# Network selector for multi-chain support
# Options: mantle-testnet, mantle-sepolia, mantle-mainnet, stellar-testnet, stellar-futurenet
BLOCKCHAIN_NETWORK=mantle-testnet

# Master Network Switch (mantle | stellar) - Deprecated, use BLOCKCHAIN_NETWORK
NETWORK_TYPE=mantle

# Enabled Networks (comma-separated)
ENABLED_NETWORKS=mantle,bnb,stellar,arbitrum

#Mantle RWA Backend Env
JWT_SECRET=
MONGODB_URI=

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis Cloud Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# =============================================================================
# MANTLE/EVM CONFIGURATION
# =============================================================================

# --- Mantle/EVM Configuration ---
MANTLE_RPC_URL=
MANTLE_WSS_URL=
CHAIN_ID=5003

# --- BNB Testnet Configuration ---
BNB_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BNB_WSS_URL=
BNB_CHAIN_ID=97

# --- Arbitrum Sepolia Configuration ---
ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_WSS_URL=
ARBITRUM_CHAIN_ID=421614

# Dummy Private Keys for Dev (DO NOT USE IN PRODUCTION)
ADMIN_PRIVATE_KEY=
PLATFORM_PRIVATE_KEY=
CUSTODY_WALLET_ADDRESS=

# Admin wallet for receiving platform fees (Mantle/EVM)
BLOCKCHAIN_ADMIN_WALLET=

# Contract Addresses (EVM) - Optional: will be loaded from deployed_contracts.json
ATTESTATION_REGISTRY_ADDRESS=
IDENTITY_REGISTRY_ADDRESS=
TOKEN_FACTORY_ADDRESS=
YIELD_VAULT_ADDRESS=
PRIMARY_MARKETPLACE_ADDRESS=
TRUSTED_ISSUERS_REGISTRY_ADDRESS=
USDC=
