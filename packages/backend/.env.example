# =============================================================================
# STELLAR/SOROBAN CONFIGURATION
# =============================================================================

# --- Stellar/Soroban Configuration (Required only if BLOCKCHAIN_NETWORK=stellar-*) ---
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_ADMIN_SECRET=
STELLAR_PLATFORM_SECRET=
# Admin wallet for receiving platform fees (Stellar) - public key
STELLAR_ADMIN_PUBLIC=

# Soroban Contract IDs - Optional: will be loaded from deployed_contracts.json
STELLAR_ATTESTATION_REGISTRY_CONTRACT_ID=
STELLAR_IDENTITY_REGISTRY_CONTRACT_ID=
STELLAR_ASSET_REGISTRY_CONTRACT_ID=
STELLAR_PRIMARY_MARKET_CONTRACT_ID=
STELLAR_TRUSTED_ISSUERS_REGISTRY_CONTRACT_ID=
STELLAR_PRIMARY_MARKET_CONTRACT_ID=
# Circle USDC SAC contract ID on Stellar (required for auction listings)
# Defaults to Circle testnet USDC if not set: USDC:GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
STELLAR_USDC_CONTRACT=
STELLAR_YIELD_VAULT_CONTRACT_ID=
