{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@openassets/types": [
        "../types/src/index.ts"
      ],
      "@openassets/types/*": [
        "../types/src/*"
      ],
      "@contracts/mantle": [
        "../contracts/index.ts"
      ],
      "@contracts/mantle/*": [
        "../contracts/*"
      ],
      "@contracts/arbitrum": [
        "../arbitrum-contracts/index.ts"
      ],
      "@contracts/arbitrum/*": [
        "../arbitrum-contracts/*"
      ],
      "@contracts/stellar": [
        "../stellar-contracts/index.ts"
      ],
      "@contracts/stellar/*": [
        "../stellar-contracts/*"
      ]
    },
    "types": [
      "jest",
      "node",
      "multer"
    ]
  },
  "include": [
    "src/**/*",
    "src/modules/marketplace/services/purchase-tracker.service.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}