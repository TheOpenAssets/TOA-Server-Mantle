{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@openassets/types": [
        "../types/src/index.ts"
      ],
      "@openassets/types/*": [
        "../types/src/*"
      ],
      "@mantle/contracts/*": [
        "../contracts/generated/*"
      ]
    },
    "types": [
      "jest",
      "node",
      "multer"
    ]
  },
  "include": [
    "src/**/*",
    "src/modules/marketplace/services/purchase-tracker.service.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}