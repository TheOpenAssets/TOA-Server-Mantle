{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@contracts/creditcoin/*": ["./src/*"]
    }
  },
  "include": ["./src/**/*", "scripts/**/*", "hardhat.config.ts", "index.ts"]
}
