{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@openassets/types": ["./packages/types/src/index.ts"],
      "@openassets/types/*": ["./packages/types/src/*"],
      "@mantle/contracts/*": ["./packages/contracts/generated/*"]
    },
    "types": ["jest", "node", "multer"]
  }
}
