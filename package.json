{
  "name": "mantle-rwa-platform",
  "private": true,
  "packageManager": "yarn@4.6.0+sha512.5383cc12567a95f1d668fbe762dfe0075c595b4bfff433be478dbbe24e05251a8e8c3eb992a986667c1d53b6c3a9c85b8398c35a960587fbd9fa3a0915406728",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspaces foreach -A -pt run dev",
    "build": "yarn workspaces foreach -A -pt run build",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "generate:types": "yarn workspaces foreach -A -pt --include '@contracts/*' run generate:types",
    "sync-env": "cp .env packages/backend/.env && cp .env packages/contracts/.env"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^14.5.0",
    "@types/node": "^25.0.3",
    "bip39": "^3.1.0",
    "dotenv": "^16.4.5",
    "ed25519-hd-key": "^1.3.0"
  }
}
